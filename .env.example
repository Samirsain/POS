# Next.js server (Vercel project env vars). Neither key belongs in the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role key from Supabase > Settings > API>

# Optional shared gate. Unset = anyone with the URL can print. There are no
# user accounts in this build by decision; this is the one knob if you want one.
ACCESS_CODE=
